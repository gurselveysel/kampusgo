{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kampusgo.uzemgo.com/schemas/medical-simulation/scenario-event-v1.json",
  "title": "TEYS Medical Simulation Scenario Event",
  "description": "A deterministic, auditable state transition generated by a learner action inside a synthetic clinical simulation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "scenario_id",
    "scenario_version",
    "module_id",
    "sequence",
    "occurred_at_simulation_second",
    "actor",
    "action",
    "patient_state_before",
    "patient_state_after",
    "score_effect",
    "safety_classification",
    "expert_approval_reference"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "pattern": "^evt_[a-zA-Z0-9_-]{12,64}$"
    },
    "scenario_id": {
      "type": "string",
      "pattern": "^scn_[a-zA-Z0-9_-]{6,64}$"
    },
    "scenario_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "module_id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "occurred_at_simulation_second": {
      "type": "integer",
      "minimum": 0
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "role"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["learner", "team_member", "system", "patient"]
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "synthetic_id": {
          "type": ["string", "null"],
          "maxLength": 80
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action_id", "label", "category", "clinical_rationale"],
      "properties": {
        "action_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{2,80}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 220
        },
        "category": {
          "type": "string",
          "enum": [
            "communication",
            "assessment",
            "history",
            "examination",
            "reasoning",
            "diagnostic_test",
            "medication",
            "procedure",
            "resuscitation",
            "team_management",
            "handoff",
            "reassessment"
          ]
        },
        "clinical_rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1500
        },
        "learner_justification": {
          "type": ["string", "null"],
          "maxLength": 2000
        },
        "time_cost_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7200
        },
        "financial_cost_minor_units": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "patient_state_before": {
      "$ref": "#/$defs/patientState"
    },
    "patient_state_after": {
      "$ref": "#/$defs/patientState"
    },
    "score_effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total_delta", "dimensions"],
      "properties": {
        "total_delta": {
          "type": "integer",
          "minimum": -100,
          "maximum": 100
        },
        "dimensions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "clinical_accuracy": { "type": "integer", "minimum": -100, "maximum": 100 },
            "patient_safety": { "type": "integer", "minimum": -100, "maximum": 100 },
            "timeliness": { "type": "integer", "minimum": -100, "maximum": 100 },
            "resource_stewardship": { "type": "integer", "minimum": -100, "maximum": 100 },
            "communication": { "type": "integer", "minimum": -100, "maximum": 100 },
            "leadership": { "type": "integer", "minimum": -100, "maximum": 100 }
          }
        }
      }
    },
    "safety_classification": {
      "type": "string",
      "enum": ["positive", "neutral", "warning", "critical"]
    },
    "critical_signal": {
      "type": ["string", "null"],
      "maxLength": 500
    },
    "debrief_anchor": {
      "type": ["string", "null"],
      "maxLength": 1000
    },
    "expert_approval_reference": {
      "type": "string",
      "minLength": 6,
      "maxLength": 200
    },
    "source_references": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "source_version"],
        "properties": {
          "source_id": { "type": "string", "maxLength": 200 },
          "source_version": { "type": "string", "maxLength": 100 },
          "locator": { "type": ["string", "null"], "maxLength": 500 }
        }
      }
    }
  },
  "$defs": {
    "patientState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "consciousness",
        "pain_score",
        "heart_rate",
        "systolic_bp",
        "diastolic_bp",
        "spo2",
        "respiratory_rate",
        "temperature_c",
        "rhythm"
      ],
      "properties": {
        "phase": {
          "type": "string",
          "enum": [
            "assessment",
            "revealing",
            "reasoning",
            "diagnostics",
            "treatment",
            "vf",
            "rosc",
            "team",
            "integrated"
          ]
        },
        "consciousness": {
          "type": "string",
          "enum": ["alert", "verbal", "pain", "unresponsive"]
        },
        "pain_score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "heart_rate": {
          "type": "integer",
          "minimum": 0,
          "maximum": 250
        },
        "systolic_bp": {
          "type": "integer",
          "minimum": 0,
          "maximum": 300
        },
        "diastolic_bp": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200
        },
        "spo2": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "respiratory_rate": {
          "type": "integer",
          "minimum": 0,
          "maximum": 80
        },
        "temperature_c": {
          "type": "number",
          "minimum": 25,
          "maximum": 45
        },
        "rhythm": {
          "type": "string",
          "enum": ["sinus", "stemi", "vf", "rosc"]
        },
        "visible_signs": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "string",
            "maxLength": 160
          }
        },
        "active_interventions": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "string",
            "maxLength": 160
          }
        }
      }
    }
  }
}

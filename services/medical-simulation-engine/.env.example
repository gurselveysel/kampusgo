# Service boundary
ENVIRONMENT=development
MEDICAL_ENGINE_MODE=preview
MEDICAL_ENGINE_API_TOKEN=
MEDICAL_ENGINE_CORS_ORIGINS=http://localhost:3000,https://kampusgo.uzemgo.com
MEDICAL_ENGINE_MAX_PARALLEL_JOBS=2

# AI mode: Azure OpenAI is the primary upstream provider
LLM_PROVIDER=azure
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-5
AZURE_OPENAI_REASONING_EFFORT=low

# Optional upstream alternative
DEDALUS_API_KEY=

# Voiceover
VOICEOVER_TTS_SERVICE=gtts
VOICEOVER_VOICE_NAME=
VOICEOVER_TTS_MODEL=gpt-4o-mini-tts

# Isolated render gate — both values are required for rendering
MEDICAL_ENGINE_ALLOW_RENDER=0
MEDICAL_ENGINE_RENDER_QUALITY=low_quality
MEDICAL_ENGINE_ENABLE_IMPORT_TEST=0
MEDICAL_ENGINE_MAX_RETRIES=2
RENDER_MODE=local
STORAGE_MODE=local
MEDIA_DIR=/data/videos

# Optional S3-compatible storage
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_PUBLIC_URL=

# Optional tracing
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

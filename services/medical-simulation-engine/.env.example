# TEYS arXivisual Medical Simulation — controlled pilot
# Copy to .env. Never commit the resulting .env file.

ENVIRONMENT=development
PORT=8000
LOG_LEVEL=INFO

# Required for all protected endpoints. Use at least 32 random characters.
MEDICAL_SIMULATION_API_KEY=replace-with-at-least-32-random-characters
MEDICAL_SIMULATION_ALLOW_UNAUTHENTICATED=false
MEDICAL_SIMULATION_DOCS_ENABLED=true
MEDICAL_SIMULATION_MAX_REQUEST_BYTES=1048576

# Cost and concurrency fuse.
MEDICAL_SIMULATION_MAX_JOBS_PER_WINDOW=3
MEDICAL_SIMULATION_RATE_WINDOW_SECONDS=3600
MEDICAL_SIMULATION_RENDER_CONCURRENCY=1

# Local pilot persistence.
MEDICAL_SIMULATION_JOB_DIR=/data/jobs
MEDIA_DIR=/data/media/videos
VOICEOVER_CACHE_DIR=/data/cache/voiceovers
STORAGE_MODE=local
RENDER_MODE=local

# Direct browser calls are not required when the Next.js gateway is used.
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://teys-medikal-simulasyon-pilot.vercel.app

# Real arXivisual AI generation requires exactly one provider configuration.
LLM_PROVIDER=azure
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=replace-me
AZURE_OPENAI_DEPLOYMENT=gpt-5
AZURE_OPENAI_REASONING_EFFORT=low
# DEDALUS_API_KEY=

# Narration is optional; the first controlled pilot keeps it disabled at the UI.
VOICEOVER_TTS_SERVICE=gtts
VOICEOVER_VOICE_NAME=nova

# Optional R2 storage. Leave empty while STORAGE_MODE=local.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=

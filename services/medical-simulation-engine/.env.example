ENVIRONMENT=development
PORT=8080
CORS_ALLOW_ORIGINS=http://localhost:3000,https://kampusgo.uzemgo.com

# Azure OpenAI / GPT-5
LLM_PROVIDER=azure
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-5
AZURE_OPENAI_REASONING_EFFORT=low

# Optional observability
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Voiceover / TTS
VOICEOVER_TTS_SERVICE=openai
VOICEOVER_TTS_MODEL=gpt-4o-mini-tts
VOICEOVER_VOICE_NAME=nova

# Rendering
TEYS_UPSTREAM_BACKEND=/app/visual-lab-upstream/backend
MEDICAL_RENDER_ROOT=/app/media/renders
MANIM_RENDER_TIMEOUT_SECONDS=240
ALLOW_GENERATED_MANIM_EXECUTION=0

ENVIRONMENT=development
PORT=8000
LOG_LEVEL=INFO

# Required for every protected engine route. Generate with: openssl rand -base64 48
TEYS_ENGINE_API_KEY=replace-with-at-least-32-random-characters
TEYS_ENGINE_DATA_DIR=/data
TEYS_ENGINE_JOBS_DIR=/data/jobs
TEYS_ENGINE_MAX_REQUEST_BYTES=262144
TEYS_ENGINE_JOB_LIMIT_PER_HOUR=3
TEYS_ENGINE_MAX_CONCURRENT_JOBS=1
TEYS_ENGINE_DOCS_ENABLED=true

CORS_ALLOWED_ORIGINS=http://localhost:3000,https://teys-medikal-simulasyon-pilot.vercel.app

# auto: use arXivisual AI generator when a provider is configured; otherwise safe template fallback.
# azure/dedalus: fail instead of falling back when provider generation fails.
# template: deterministic arXivisual validation + Manim render only.
MEDICAL_AI_MODE=auto
MEDICAL_VOICEOVER_ENABLED=false
MEDICAL_RENDER_QUALITY=low_quality
VOICEOVER_TTS_SERVICE=gtts
VOICEOVER_VOICE_NAME=nova
VOICEOVER_CACHE_DIR=/data/voiceovers
MEDIA_DIR=/data/media
RENDER_MODE=local

# Azure OpenAI for real arXivisual AI scene generation.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-5
AZURE_OPENAI_REASONING_EFFORT=low

# Optional legacy provider.
DEDALUS_API_KEY=

# Optional observability.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=pilot

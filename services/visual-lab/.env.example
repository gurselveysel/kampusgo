# KampüsGO Visual Lab — controlled pilot
# Copy to services/visual-lab/.env. Never commit the resulting .env file.

ENVIRONMENT=development
PORT=8000
LOG_LEVEL=INFO

# Required for every protected /api/* route except /api/health.
# Generate a long random value; do not reuse a user password.
VISUAL_LAB_API_KEY=replace-with-at-least-32-random-characters
VISUAL_LAB_ALLOW_UNAUTHENTICATED=false
VISUAL_LAB_RAW_RENDER_ENABLED=false
VISUAL_LAB_DOCS_ENABLED=true
VISUAL_LAB_MAX_REQUEST_BYTES=1048576

# Direct browser access is not required when KampüsGO uses its server-side
# gateway. Keep this list narrow.
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://kampusgo.uzemgo.com
CORS_ALLOWED_ORIGIN_REGEX=

# Local pilot persistence. Production should use an approved PostgreSQL URL.
DATABASE_URL=sqlite+aiosqlite:////data/visual-lab.db
STORAGE_MODE=local
RENDER_MODE=local
USE_TEMPORAL=0
PIPELINE_CONCURRENCY=1
RENDER_CONCURRENCY=1

# Azure OpenAI — required for real analysis and scene generation.
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=replace-me
AZURE_OPENAI_DEPLOYMENT=gpt-5
AZURE_OPENAI_REASONING_EFFORT=low

# Pilot narration can use gTTS. Switch to openai only after a TTS deployment
# and cost controls are configured.
VOICEOVER_TTS_SERVICE=gtts
VOICEOVER_VOICE_NAME=nova
VOICEOVER_TTS_MODEL=gpt-4o-mini-tts

# Optional observability.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development

# Optional R2 storage. Leave empty while STORAGE_MODE=local.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=

# Bu iki değer istemci tarafında kullanılabilen yayınlanabilir Supabase bilgileridir.
# Service role / secret key kesinlikle bu dosyaya veya tarayıcı koduna yazılmaz.
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# TEYS arXivisual medical-simulation server gateway. These values are server-only.
MEDICAL_SIMULATION_GATEWAY_ENABLED=false
MEDICAL_SIMULATION_API_URL=http://127.0.0.1:8002
MEDICAL_SIMULATION_API_KEY=replace-with-at-least-32-random-characters
MEDICAL_SIMULATION_PILOT_ACCESS_TOKEN=replace-with-a-different-32-character-random-token
MEDICAL_SIMULATION_MEDIA_ALLOWED_HOSTS=

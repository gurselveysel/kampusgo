# Bu iki değer istemci tarafında kullanılabilen yayınlanabilir Supabase bilgileridir.
# Service role / secret key kesinlikle bu dosyaya veya tarayıcı koduna yazılmaz.
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Yalnız sunucu tarafında okunur. Tarayıcıya NEXT_PUBLIC_ önekiyle verilmez.
# Pilot Visual Lab FastAPI servisinin taban adresi ve servis anahtarıdır.
VISUAL_LAB_API_URL=http://localhost:8001
VISUAL_LAB_API_KEY=replace-with-the-same-long-random-value-used-by-the-backend

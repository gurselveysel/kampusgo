# Bu iki değer istemci tarafında kullanılabilen yayınlanabilir Supabase bilgileridir.
# Service role / secret key kesinlikle bu dosyaya veya tarayıcı koduna yazılmaz.
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# TEYS Medikal Simülasyon arXivisual geçidi varsayılan olarak kapalıdır.
# Container ve secret doğrulamaları tamamlanmadan true yapılmaz.
MEDICAL_SIMULATION_GATEWAY_ENABLED=false
MEDICAL_SIMULATION_ENGINE_URL=http://127.0.0.1:8002
MEDICAL_SIMULATION_ENGINE_KEY=replace-with-the-same-long-random-key-used-by-the-engine
MEDICAL_SIMULATION_PILOT_ACCESS_TOKEN=replace-with-a-different-long-random-pilot-token
